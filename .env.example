# 复制为 .env 并填入真实值(.env 不会进 git)

# DeepSeek API Key(必填, 否则 /ask 返回未配置)
DEEPSEEK_API_KEY=

# 可选: 模型与上游地址(默认 deepseek-v4-flash / https://api.deepseek.com)
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选: 独立部署端口与每 IP 限流(分钟级防刷 + 小时级兜底)
# PORT=8787
# ASSISTANT_RATE_ASK_MIN=5          # 每分钟最多提问次数
# ASSISTANT_RATE_ASK=30             # 每小时最多提问次数
# ASSISTANT_RATE_SEARCH_MIN=20      # 每分钟最多检索次数
# ASSISTANT_RATE_SEARCH=120         # 每小时最多检索次数

# 可选: 识图输入(检索命中图片时把原图发给模型看图回答), 设 0 关闭
# ASSISTANT_VISION=1

# 前端构建注入的助手后端地址(留空 = 同源 /api/assistant, 与后端同域名/同进程部署时即默认值)
# ASSISTANT_API=http://localhost:8787

# 本机一键推送部署(scripts/deploy.py 读取, 用法见 docs/linux-deploy.md 第 6 节)
# DEPLOY_HOST=服务器IP
# DEPLOY_PORT=22
# DEPLOY_USER=root
# DEPLOY_PASS=服务器SSH密码        # 与 DEPLOY_KEY 二选一
# DEPLOY_KEY=~/.ssh/id_rsa
# DEPLOY_ROOT=/www/hs2
# DEPLOY_PM2_NAME=hs2                # 服务器上现有 pm2 进程名(手动部署过请填实际名)
